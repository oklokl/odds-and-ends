<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Week" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Android 15(API 35+)에서 지원 중단된 SHORT_EDGES 대신 ALWAYS 모드 적용 -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>

        <!-- Android 12+ Splash Screen (앱 시작 화면) -->
        <item name="android:windowSplashScreenBackground">#F4F8FD</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
