<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 배경 이미지 (폰은 2번 사진, 태블릿은 3번 사진이 자동 적용됨) -->
    <ImageView
        android:id="@+id/backgroundImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_main"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 주기도문 반투명 글래스모피즘 카드 -->
    <FrameLayout
        android:id="@+id/prayerCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/prayer_card_bg"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/secondaryButtonLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="560dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- 상단 십자가 장식 -->
                <ImageView
                    android:id="@+id/ornamentCross"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginBottom="18dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ornament_cross" />

                <!-- 기도문 1절 -->
                <TextView
                    android:id="@+id/prayerTextPart1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="7dp"
                    android:shadowColor="@color/prayer_text_shadow"
                    android:shadowDx="0.0"
                    android:shadowDy="1.2"
                    android:shadowRadius="3.5"
                    android:text="@string/prayer_part1"
                    android:textColor="@color/prayer_text_color"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- 중간 나뭇잎 장식 -->
                <ImageView
                    android:id="@+id/ornamentLeaf1"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ornament_leaf" />

                <!-- 기도문 2절 -->
                <TextView
                    android:id="@+id/prayerTextPart2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="7dp"
                    android:shadowColor="@color/prayer_text_shadow"
                    android:shadowDx="0.0"
                    android:shadowDy="1.2"
                    android:shadowRadius="3.5"
                    android:text="@string/prayer_part2"
                    android:textColor="@color/prayer_text_color"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- 하단 나뭇잎 장식 -->
                <ImageView
                    android:id="@+id/ornamentLeaf2"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ornament_leaf" />

                <!-- 기도문 3절 (아멘) -->
                <TextView
                    android:id="@+id/prayerTextPart3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:shadowColor="@color/prayer_text_shadow"
                    android:shadowDx="0.0"
                    android:shadowDy="1.2"
                    android:shadowRadius="3.5"
                    android:text="@string/prayer_part3"
                    android:textColor="@color/prayer_text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 보조 버튼 영역 (음성 변경 / 기본 / 유지) -->
    <LinearLayout
        android:id="@+id/secondaryButtonLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/mainButtonLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voiceChangeButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/voice_change_button_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/btn_press_animator"
            android:text="@string/btn_voice_change"
            android:textColor="@color/coral_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_speaker"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/coral_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setSelectButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/set_select_button_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/btn_press_animator"
            android:text="기본"
            android:textColor="@color/secondary_btn_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="#424242" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/keepScreenOnButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/set_select_button_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/btn_press_animator"
            android:text="@string/btn_keep_screen_on"
            android:textColor="@color/secondary_btn_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_bookmark"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="#424242" />
    </LinearLayout>

    <!-- 메인 재생 / 정지 버튼 영역 -->
    <LinearLayout
        android:id="@+id/mainButtonLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="420dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_purple"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@animator/btn_press_animator"
            android:text="@string/btn_play"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_play_white"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_purple"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@animator/btn_press_animator"
            android:text="@string/btn_stop"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_stop_white"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
