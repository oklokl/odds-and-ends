<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/regionDialogPinnedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/region_pinned_none"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/regionSearchEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/region_search_hint"
            android:inputType="text"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <NumberPicker
                android:id="@+id/regionNumberPicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:descendantFocusability="blocksDescendants" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <Button
                    android:id="@+id/regionSearchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/region_search_btn"
                    android:minWidth="92dp" />

                <Button
                    android:id="@+id/regionCloseButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/region_close_btn"
                    android:minWidth="92dp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/regionResetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/region_reset_btn"
                    android:minWidth="92dp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/regionPinButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/region_pin_btn"
                    android:minWidth="92dp"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/regionConfirmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/region_confirm_btn"
                    android:minWidth="92dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
