<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- 풍향계 -->
        <TextView
            android:id="@+id/windTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wind_popup_title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="center" />

        <!-- 원(풍향계) 크기 축소 -->
        <com.krdonon.wweather.WindVaneView
            android:id="@+id/windVaneView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/windValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wind_from_na"
            android:textSize="14sp"
            android:textColor="@color/value_red"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- 나침판 -->
        <TextView
            android:id="@+id/compassTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/compass_popup_title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:gravity="start" />

        <!-- 원(나침판) 크기 축소 -->
        <com.krdonon.wweather.CompassView
            android:id="@+id/compassView"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/compassValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/compass_heading_na"
            android:textSize="14sp"
            android:textColor="@color/value_red"
            android:gravity="start"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/compassHelpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibrate_hint"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

    </LinearLayout>
</ScrollView>
