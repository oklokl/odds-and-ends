<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/regionDialogPinnedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="고정: 없음"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/regionSearchEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="지역 검색"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <NumberPicker
            android:id="@+id/regionNumberPicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:descendantFocusability="blocksDescendants" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <Button
                android:id="@+id/regionSearchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="검색"
                android:minWidth="92dp" />

            <Button
                android:id="@+id/regionCloseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나가기"
                android:minWidth="92dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/regionResetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="초기화"
                android:minWidth="92dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/regionPinButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="고정"
                android:minWidth="92dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/regionConfirmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="확인"
                android:minWidth="92dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
