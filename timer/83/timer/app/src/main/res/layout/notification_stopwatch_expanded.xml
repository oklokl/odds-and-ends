<?xml version="1.0" encoding="utf-8"?>
<!--
  스톱워치 알림(펼친 상태)
  - 제목은 ClockService.setSubText()를 통해 SystemUI 헤더의 앱 이름 옆에 표시한다.
    예: "내일 타이머 · 스톱워치" / "내일 타이머 · 스톱워치 2"
  - 본문에는 정확한 elapsedRealtime 기반 Chronometer만 한 줄로 크게 표시한다.
  - Chronometer는 24시간에서 초기화되지 않으며 100시간/120시간 이상도 그대로 표시한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <Chronometer
        android:id="@+id/stopwatch_notification_chronometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format="%s"
        android:gravity="start|center_vertical"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="22sp"
        android:autoSizeMaxTextSize="36sp"
        android:autoSizeStepGranularity="1sp"
        android:textSize="36sp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
