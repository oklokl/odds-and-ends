<resources>
    <!-- 알람 풀스크린 전용 테마 -->
    <style name="Theme.Timer.FullScreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
    </style>

    <!-- 미니 달력 기본 스타일 -->
    <style name="MiniCalendar">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 미니 달력 요일 헤더 스타일 -->
    <style name="MiniCalendar.Weekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">?attr/appTextSecondary</item>
    </style>

    <!-- 공통 M3 카드 스타일 -->
    <style name="Timer.SurfaceCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/appSurfaceCard</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/appStrokeColor</item>
    </style>

    <!-- 공통 M3 버튼 위계 -->
    <style name="Timer.PrimaryPillButton" parent="Widget.Material3.Button">
        <item name="android:textColor">?attr/appOnAccentPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@animator/btn_press_animator</item>
        <item name="backgroundTint">?attr/appAccentPrimary</item>
        <item name="strokeColor">?attr/appPrimaryStrokeColor</item>
        <item name="strokeWidth">?attr/appPrimaryStrokeWidth</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="Timer.TonalPillButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">?attr/appOnPrimaryContainer</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@animator/btn_press_animator</item>
        <item name="backgroundTint">?attr/appPrimaryContainer</item>
        <item name="strokeColor">?attr/appPrimaryStrokeColor</item>
        <item name="strokeWidth">?attr/appPrimaryStrokeWidth</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Timer.OutlinedPillButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@animator/btn_press_animator</item>
        <item name="backgroundTint">?attr/appSurfaceCard</item>
        <item name="strokeColor">?attr/appStrokeColor</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Timer.CirclePresetButton" parent="Widget.Material3.Button">
        <item name="android:textColor">?attr/appOnAccentPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:stateListAnimator">@animator/btn_press_animator</item>
        <item name="backgroundTint">?attr/appAccentPrimary</item>
        <item name="strokeColor">?attr/appPrimaryStrokeColor</item>
        <item name="strokeWidth">?attr/appPrimaryStrokeWidth</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="cornerRadius">48dp</item>
    </style>

    <style name="Timer.DayToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:elevation">1dp</item>
        <item name="android:stateListAnimator">@animator/btn_press_animator</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="cornerRadius">22dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 2번째 스톱워치 버튼 스타일 (M3 전환) -->
    <style name="Timer.SecondStopwatchPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textColor">?attr/appOnAccentPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">5dp</item>
        <item name="android:stateListAnimator">@animator/btn_press_animator</item>
        <item name="backgroundTint">?attr/appAccentPrimary</item>
        <item name="strokeColor">?attr/appPrimaryStrokeColor</item>
        <item name="strokeWidth">?attr/appPrimaryStrokeWidth</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="Timer.SecondStopwatchSecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@animator/btn_press_animator</item>
        <item name="backgroundTint">?attr/appSurfaceCard</item>
        <item name="strokeColor">?attr/appStrokeColor</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">22dp</item>
    </style>
</resources>
