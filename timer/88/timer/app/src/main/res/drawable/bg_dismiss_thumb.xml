<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="50dp"
                android:height="50dp" />
            <solid android:color="?attr/appAccentPrimary" />
            <stroke
                android:width="3dp"
                android:color="?attr/appStrokeColor" />
        </shape>
    </item>
    <item
        android:bottom="13dp"
        android:drawable="@drawable/ic_arrow_forward"
        android:left="13dp"
        android:right="13dp"
        android:top="13dp" />
</layer-list>
