<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBgColor"
    tools:context=".StopWatchFragment">

    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupClassicStopwatch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="stopwatchDisplayCard,buttonLayout,lapListCard" />

    <!-- 메인 스톱워치 디스플레이 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stopwatchDisplayCard"
        style="@style/Timer.SurfaceCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/stopwatchText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="44sp"
            android:autoSizeMinTextSize="26sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="monospace"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingTop="28dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp"
            android:shadowColor="#55000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="5"
            android:text="00:00:00.000"
            android:textColor="?attr/appTextPrimary"
            android:textSize="40sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 컨트롤 버튼 바 -->
    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stopwatchDisplayCard">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLapReset"
            style="@style/Timer.OutlinedPillButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="초기화"
            android:textSize="13sp"
            app:cornerRadius="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartStop"
            style="@style/Timer.PrimaryPillButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.15"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="시작"
            android:textSize="14sp"
            app:cornerRadius="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchStopwatch"
            style="@style/Timer.TonalPillButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="전환"
            android:textSize="13sp"
            app:cornerRadius="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeepScreenClassic"
            style="@style/Timer.OutlinedPillButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="유지"
            android:textSize="13sp"
            app:cornerRadius="26dp" />

    </LinearLayout>

    <!-- 랩 기록 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lapListCard"
        style="@style/Timer.SurfaceCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonLayout">

        <ListView
            android:id="@+id/lapListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="?attr/appDivider"
            android:dividerHeight="1dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            tools:listitem="@layout/item_lap_classic" />
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/secondStopwatchContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
