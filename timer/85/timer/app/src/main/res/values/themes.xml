<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Mint / Sage Material 3) -->
    <style name="Theme.Timer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/on_accent_primary</item>
        <item name="colorPrimaryContainer">@color/accent_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="colorOnSecondary">@color/on_accent_primary</item>
        <item name="colorSecondaryContainer">@color/accent_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="android:colorBackground">@color/timer_bg</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceContainer">@color/surface_bottom_bar</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider_subtle</item>
    </style>
</resources>
